+/// The narrowest wave the host GPU runs (0: not known – no host-specific forms); see
+/// [`set_host_min_wave`].
+static HOST_MIN_WAVE: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+/// The host GPU's `WaveLaneCountMin`: 64 (the vendor's cards before RDNA, which have no
+/// 32-lane waves) refuses `WaveSize(32)`, so a console wave32 compute program whose group
+/// is one wave is declared without a wave size and runs in the first 32 lanes of a 64-lane
+/// wave, where the lanes that are elsewhere contribute nothing.
+pub fn set_host_min_wave(lanes: u32) {
+    HOST_MIN_WAVE.store(lanes, std::sync::atomic::Ordering::Relaxed);
+}
