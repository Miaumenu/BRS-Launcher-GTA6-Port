+/// A console wave32 program whose cross-lane code needs the console's own 32 lanes (a lane
+/// mask read as a number), on a host whose narrowest wave is 64 lanes (the vendor's cards
+/// before RDNA, which have no 32-lane waves and refuse `WaveSize(32)`). Where the group is
+/// one console wave the wave size is not declared: the group runs in the first 32 lanes of a
+/// 64-lane wave, and the lanes that are elsewhere are in none of its ballots, reductions or
+/// lane reads, which is what the console's wave does. A group of two console waves would
+/// share one host wave, where that code would reach the other wave's lanes: it keeps the
+/// declaration, and the host refuses the pipeline instead of running it with both.
+#[test]
+fn a_wave32_group_of_one_wave_drops_its_declaration_on_64_lane_waves() {
+    let words = [
+        0xD765_0001,
+        0x0001_00C1, // v_mbcnt_lo_u32_b32 v1, -1, 0
+        0x38 << 26 | 0x1C << 18,
+        0x80 << 24 | 2 << 16 | 1 << 8, // buffer_store_dword v1, off, s[8:11], 0
+    ];
+    let declared = |threads: u32, host_min: u32| {
+        let native = native_of(&words, false, threads);
+        let p = ir::build(&native.code, native.wave64, native.vgprs).expect("ir::build");
+        let st = structure::structure(&p).expect("structure");
+        let res =
+            resource::track(&p, &native.layout, native.stage, Some(&st)).expect("resource::track");
+        let io = io::raise(&p, &native).expect("io::raise");
+        let was_max = lower::TEST_HOST_WAVE.replace(Some(64));
+        let was_min = lower::TEST_HOST_MIN_WAVE.replace(Some(host_min));
+        let lowered = lower::lower(&lower::Parts {
+            native: &native,
+            p: &p,
+            st: &st,
+            io: &io,
+            res: &res,
+            inputs: Vec::new(),
+            outputs: Vec::new(),
+            prims: Vec::new(),
+            mesh_stride: 0,
+        });
+        lower::TEST_HOST_MIN_WAVE.set(was_min);
+        lower::TEST_HOST_WAVE.set(was_max);
+        lowered.expect("lower").wave_size
+    };
+    // a host with 32-lane waves takes the declaration, as before
+    assert_eq!(declared(32, 32), Some(32));
+    // one console wave: it runs in the first 32 lanes of a 64-lane wave, undeclared
+    assert_eq!(declared(32, 64), None);
+    // two console waves in one host wave: declared, for the host to refuse
+    assert_eq!(declared(64, 64), Some(32));
+}
+
